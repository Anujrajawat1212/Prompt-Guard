{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 Run Streamlit Chatbot (F5)",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "🎯 Train ML Model",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/detection/train_model.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🧪 Run All Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/run_all_tests.py",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}